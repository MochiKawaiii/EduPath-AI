# Generated by: node scripts/setup-ai-worker.mjs [API_URL] [--num-gpu=N]
# Only these keys are read by the AI worker. Do not commit the real services/ai/.env.
AI_API_URL=http://localhost:4000
# Same value as AI_WORKER_KEY in apps/api/.env (>= 32 characters, different from OCR_WORKER_KEY).
AI_WORKER_KEY=replace-with-the-generated-key-at-least-32-characters
# Loopback only. Never expose Ollama on 0.0.0.0.
OLLAMA_URL=http://127.0.0.1:11434
OLLAMA_MODEL=gemma4:e4b
OLLAMA_CONTEXT=16384
AI_TIMEOUT_MS=600000
# Optional: number of model layers on the GPU (RTX 3050 4 GB: 38 measured fastest; see README).
# OLLAMA_NUM_GPU=38
