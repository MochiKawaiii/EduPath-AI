# Server
NODE_ENV=development
PORT=4000
WEB_ORIGIN=http://localhost:5173
SESSION_SECRET=replace-with-a-random-string-at-least-32-characters
SESSION_MAX_AGE_MS=28800000
TRUST_PROXY=false

# PostgreSQL
DATABASE_URL=postgresql://edupath_codex:replace-with-database-password@localhost:5432/edupath_ai
DATABASE_POOL_MAX=10
DATABASE_CONNECTION_TIMEOUT_MS=5000
DATABASE_IDLE_TIMEOUT_MS=30000
DATABASE_AUTO_MIGRATE=true

# Microsoft Entra ID (multitenant development app)
ENTRA_CLIENT_ID=00000000-0000-0000-0000-000000000000
ENTRA_CLIENT_SECRET=replace-with-the-client-secret-value
ENTRA_TENANT_ID=00000000-0000-0000-0000-000000000000
ENTRA_AUTHORITY=https://login.microsoftonline.com/organizations
ENTRA_REDIRECT_URI=http://localhost:4000/api/auth/microsoft/callback
ENTRA_POST_LOGOUT_REDIRECT_URI=http://localhost:5173/

# Demo mode: any Microsoft work/school tenant may authenticate.
# Change this to false and set ENTRA_ALLOWED_TENANT_IDS before production.
ENTRA_ALLOW_ANY_TENANT=true
ENTRA_ALLOWED_TENANT_IDS=

# Users without an Entra app role become Student only during the demo.
# Use "none" in production and require an official Student role/roster match.
AUTH_DEFAULT_ROLE=student
